# ========================================
# BUCONNECTS FRONTEND - ENVIRONMENT TEMPLATE
# ========================================
# Copy to .env.local for local development
# or .env.production for production build

# ========================================
# API Configuration
# ========================================
# For local development (offline/local backend):
VITE_API_BASE_URL=http://localhost:5000

# For production (online backend):
# VITE_API_BASE_URL=https://your-production-backend.com

# ========================================
# Build Mode
# ========================================
# Set to 'development' for dev server
# Set to 'production' for production build
VITE_MODE=development
